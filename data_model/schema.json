{
  "schema_version": "1.0",
  "description": "Schema for a single processing activity record, structured to satisfy GDPR Article 30(1) record-keeping requirements and support automated Article 35 DPIA screening.",
  "article_30_required_fields": [
    "controller_name",
    "purpose_of_processing",
    "categories_of_data_subjects",
    "categories_of_personal_data",
    "categories_of_recipients",
    "third_country_transfers",
    "retention_period",
    "security_measures"
  ],
  "dpia_screening_fields": {
    "description": "Fields used by the automated DPIA trigger logic, based on ICO/EDPB Article 35(3) and WP248 'nine criteria' guidance.",
    "fields": [
      "involves_special_category_data",
      "involves_criminal_offence_data",
      "involves_large_scale_processing",
      "involves_systematic_monitoring",
      "involves_automated_decision_making_with_legal_effect",
      "involves_vulnerable_data_subjects",
      "involves_new_technology",
      "involves_data_matching_or_combining",
      "prevents_data_subjects_exercising_rights"
    ]
  },
  "sensitivity_levels": ["low", "medium", "high"],
  "legal_bases": [
    "consent",
    "contract",
    "legal_obligation",
    "vital_interests",
    "public_task",
    "legitimate_interests"
  ]
}
